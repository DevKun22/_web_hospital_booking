# =============================================================================
# Hospital Booking - biến môi trường backend (API và các worker)
# Sao chép thành backend/.env khi chạy local. KHÔNG điền secret thật vào file này.
#
# Biến để trống hoặc đặt trong chú thích là tùy chọn. Các biến tinh chỉnh đã có
# mặc định đúng trong code nên chỉ liệt kê ở cuối file, không cần khai báo.
#
# Triển khai hiện tại: web https://hospital.ngoloi.dev (Vercel), API
# https://hospital-api.ngoloi.dev (Render), email gửi từ mail.ngoloi.dev (Resend).
# =============================================================================

# --- Chạy ---------------------------------------------------------------
PORT=4000
# Production: NODE_ENV=production (bật kiểm tra cấu hình khi khởi động).
NODE_ENV=development

# Origin HTTPS của web, phân tách bằng dấu phẩy, không kèm path.
# Production: https://hospital.ngoloi.dev
FRONTEND_URLS=http://localhost:3000,http://localhost:3001

# Cookie dashboard. Web (hospital.ngoloi.dev) và API (hospital-api.ngoloi.dev)
# cùng site ngoloi.dev nên dùng lax; chỉ dùng none khi web và API khác site.
DASHBOARD_COOKIE_SAME_SITE=lax

# --- Cơ sở dữ liệu ------------------------------------------------------
DATABASE_URL=

# CHỈ dùng bởi npm run test:integration và test:phase0/phase1. Database hoặc
# schema phải chứa chữ "test" và không được trùng DATABASE_URL. Không cấu hình
# biến này trên process API hoặc worker production.
TEST_DATABASE_URL=

# --- Bảo mật ------------------------------------------------------------
# Production: mỗi secret tối thiểu 32 ký tự, sinh riêng và khác nhau.
JWT_SECRET=
OTP_SECRET=

# Production: bắt buộc false. Local/test: true để API trả mã OTP trong response.
OTP_DEBUG_ENABLED=false

# --- OTP: email là kênh chính, SMS là kênh phụ -----------------------------
# Email (Resend) là kênh mặc định. Production phải có RESEND_API_KEY, nếu không
# hệ thống không gửi được OTP. Domain mail.ngoloi.dev đã xác minh trên Resend.
RESEND_API_KEY=
RESEND_FROM=Hospital Booking <no-reply@mail.ngoloi.dev>
# Tên thương hiệu hiển thị trong nội dung email.
MAIL_BRAND_NAME=Hospital Booking

# SMS là kênh phụ và đang TẮT vì chưa có nhà cung cấp. Để trống thì hệ thống chỉ
# dùng email. Khi có Android gateway: SMS_PROVIDER=textbee kèm hai khóa dưới.
SMS_PROVIDER=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Danh sách SĐT demo local (phân cách bằng dấu phẩy) được hiện OTP trên màn hình.
# Production từ chối khởi động nếu biến này có giá trị; không đặt trên Render.
DEMO_OTP_PHONES=

# --- Redis --------------------------------------------------------------
# Cache/API: rate limit, RBAC invalidation và readiness. Production dùng
# rediss:// khi đi qua mạng công khai; redis:// chỉ khi REDIS_PRIVATE_NETWORK=true.
# Dùng ACL user/password riêng; Redis managed có thể dùng credential của instance
# riêng biệt. Không dùng URL REST.
REDIS_URL=
# BullMQ: nên dùng ACL user riêng và maxmemory-policy=noeviction. Nếu để trống,
# hệ thống vẫn fallback REDIS_URL để tương thích nhưng sẽ cảnh báo production.
# QUEUE_REDIS_URL=
# Production bắt đầu với warn, chuyển strict sau khi đã cấu hình TLS/private network
# và ACL riêng cho API với queue.
# REDIS_SECURITY_MODE=warn                      # warn | strict
# REDIS_PRIVATE_NETWORK=false                  # true khi Redis chỉ có private endpoint
# REDIS_REQUIRED_FOR_READINESS=false           # true: Redis lỗi làm /ready trả 503

# --- Lưu trữ ảnh và file ------------------------------------------------
CLOUDINARY_URL=

# --- Chatbot Gemini -----------------------------------------------------
# Ưu tiên GEMINI_API_KEY (Gemini Developer API). Để trống thì gọi qua Firebase AI
# Logic bằng FIREBASE_API_KEY và FIREBASE_PROJECT_ID.
GEMINI_API_KEY=
FIREBASE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Thông báo đẩy (Firebase Cloud Messaging) ---------------------------
FIREBASE_PROJECT_ID=
# Chỉ cần MỘT trong hai cách cấp credential cho firebase-admin:
# Local: đường dẫn tuyệt đối tới file service-account JSON nằm ngoài Git.
GOOGLE_APPLICATION_CREDENTIALS=
# Production (Render): service-account JSON mã hóa base64, lưu bằng Secret.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Thanh toán ---------------------------------------------------------
# Trang web hiển thị kết quả sau khi thanh toán.
# Production: https://hospital.ngoloi.dev/thanh-toan/ket-qua
PAYMENT_RESULT_URL=http://localhost:3000/thanh-toan/ket-qua

# VNPay là cổng thanh toán đang dùng (sandbox: https://sandbox.vnpayment.vn).
# Đặt true khi đã có VNPAY_TMN_CODE và VNPAY_HASH_SECRET do VNPay cấp cho merchant.
PAYMENT_VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Sandbox. Production dùng URL do VNPay cấp.
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# API truy vấn giao dịch (querydr) để đối soát khi mất Return URL/IPN. Sandbox là mặc định;
# production dùng URL do VNPay cấp.
# VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# VNPay đưa người dùng về backend, backend xác thực chữ ký rồi chuyển sang
# PAYMENT_RESULT_URL. Phải là HTTPS khi production:
# https://hospital-api.ngoloi.dev/api/v1/payments/vnpay/return
VNPAY_RETURN_URL=http://localhost:4000/api/v1/payments/vnpay/return
# IPN khai báo trên cổng quản trị merchant của VNPay (không phải biến môi trường):
# https://hospital-api.ngoloi.dev/api/v1/payments/vnpay/ipn

# =============================================================================
# Tinh chỉnh (tùy chọn). Giá trị bên dưới là MẶC ĐỊNH trong code: chỉ bỏ dấu #
# và đổi khi có số đo cụ thể.
# =============================================================================
# BOOKING_HOLD_MINUTES=10
# APPOINTMENT_REMINDER_LEAD_MINUTES=120
# RATE_LIMIT_ENABLED=true                      # tắt mặc định ở NODE_ENV=test
# TRUST_PROXY_HOPS=1                           # Render: 1; chạy trực tiếp: 0

# Phiên đăng nhập
# PATIENT_ACCESS_TOKEN_EXPIRES_IN=15m
# PATIENT_WEB_SESSION_HOURS=24
# PATIENT_WEB_IDLE_MINUTES=30
# PATIENT_MOBILE_SESSION_DAYS=7
# PATIENT_SESSION_ACTIVITY_TOUCH_MINUTES=5
# DASHBOARD_ACCESS_TOKEN_EXPIRES_IN=15m
# DASHBOARD_ACCESS_COOKIE_MAX_AGE_SECONDS=900
# DASHBOARD_REFRESH_TOKEN_DAYS=7

# Cơ sở dữ liệu và quan sát
# Tổng pool của mọi API/worker cộng phần dự phòng không được vượt budget DB.
# Mặc định 1 API + 0 worker riêng: pool tự tính min((15-3)/1, 10) = 10.
# DATABASE_TOTAL_CONNECTION_BUDGET=15
# DATABASE_CONNECTION_RESERVE=3
# DATABASE_API_REPLICA_COUNT=1
# DATABASE_WORKER_REPLICA_COUNT=0              # tổng process worker riêng, không tính inline worker
# DATABASE_POOL_SIZE=10                        # tùy chọn; bỏ trống để tự tính theo công thức trên
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000     # 1000-30000
# DATABASE_POOL_IDLE_TIMEOUT_MS=30000           # 5000-300000
# DATABASE_TRANSACTION_TIMEOUT_MS=15000        # tối đa 30000
# DATABASE_TRANSACTION_MAX_WAIT_MS=5000        # tối đa 15000
# READINESS_TIMEOUT_MS=2000                    # tối đa 5000
# READINESS_CACHE_MS=5000                      # tối đa 30000
# HTTP_REQUEST_TIMEOUT_MS=120000                # 10000-300000
# HTTP_HEADERS_TIMEOUT_MS=30000                 # 5000-60000, không vượt request timeout
# HTTP_KEEP_ALIVE_TIMEOUT_MS=5000               # 1000-30000
# HTTP_MAX_REQUESTS_PER_SOCKET=1000             # 100-10000
# SLOW_REQUEST_THRESHOLD_MS=500
# DATABASE_QUERY_METRICS_ENABLED=false
# PERFORMANCE_HEADERS_ENABLED=false            # production nên giữ false
# RUNTIME_METRICS_ENABLED=true                 # mặc định true ở production
# RUNTIME_METRICS_INTERVAL_MS=60000             # 15000-900000, log DB/queue/memory

# Chatbot và tìm kiếm
# CHATBOT_AI_TIMEOUT_MS=8000                   # tối đa 12000
# CHATBOT_SETTINGS_CACHE_TTL_MS=60000
# CHATBOT_CONTEXT_CACHE_TTL_MS=30000
# PUBLIC_SEARCH_CACHE_TTL_MS=30000

# Worker
# Production chỉ dùng một topology: toàn bộ worker chạy trong tiến trình API (Render free).
# Local/test có thể để trống; production bắt buộc đúng đủ bốn tên dưới đây.
# INLINE_WORKERS=otp,appointments,notifications,payments
# OTP_WORKER_CONCURRENCY=5
# OTP_ENQUEUE_TIMEOUT_MS=1000
# APPOINTMENT_LIFECYCLE_WORKER_CONCURRENCY=5
# APPOINTMENT_RECONCILIATION_INTERVAL_MS=60000
# APPOINTMENT_RECONCILIATION_BATCH_SIZE=100
# RECONCILIATION_CONCURRENCY=4                 # 1-16, dùng chung cho các batch đối soát
# SLOT_RECONCILIATION_INTERVAL_MS=300000
# SLOT_RECONCILIATION_BATCH_SIZE=200
# NOTIFICATION_WORKER_INTERVAL_MS=30000        # tối thiểu 5000
# NOTIFICATION_DISPATCH_BATCH_SIZE=100         # tối đa 500
# NOTIFICATION_DISPATCH_CONCURRENCY=4          # 1-32
# REMINDER_DISPATCH_CONCURRENCY=4              # 1-16
# NOTIFICATION_MAX_DELIVERY_ATTEMPTS=8
# NOTIFICATION_RETENTION_DAYS=180              # tối đa 730
# NOTIFICATION_CLEANUP_INTERVAL_MS=21600000    # tối thiểu 3600000
# OUTBOX_DISPATCH_BATCH_SIZE=50                # 1-200
# OUTBOX_DISPATCH_CONCURRENCY=4                # 1-16
# OUTBOX_MAX_ATTEMPTS=8                        # 1-20
# OUTBOX_LEASE_MS=60000                        # 10000-600000
# OUTBOX_RETENTION_DAYS=30                     # 1-365
# WORKER_LOG_NOOP=false

# File y tế (backend proxy, chống SSRF): chỉ tải từ host trong danh sách.
# MEDICAL_FILE_ALLOWED_HOSTS=res.cloudinary.com
# MEDICAL_FILE_MAX_BYTES=20971520              # 20 MiB
# MEDICAL_FILE_UPLOAD_CONCURRENCY=2            # 1-16, giới hạn buffer upload trong RAM
# MEDICAL_FILE_DOWNLOAD_CONCURRENCY=8          # 1-64, giới hạn stream đồng thời
