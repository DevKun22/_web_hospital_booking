PORT=4000
# NODE_ENV=production
# DASHBOARD_COOKIE_SAME_SITE=none
NODE_ENV=development
DASHBOARD_COOKIE_SAME_SITE=lax

# Database dùng cho API, dashboard và ứng dụng khi chạy local/staging/production.
DATABASE_URL=

# CHỈ dùng bởi npm run test:integration/test:phase1. Database hoặc schema phải
# chứa chữ "test" và tuyệt đối không được trùng DATABASE_URL. Không cấu hình
# biến này trên process API/worker production.
TEST_DATABASE_URL=

# Gioi han interactive transaction cua Prisma. Mac dinh 5 giay cua Prisma co
# the qua thap khi local ket noi toi cloud DB; gia tri duoc gioi han toi da 30s.
# Production/local: 15000ms, sau do toi uu query neu thuong xuyen cham hon muc nay.
DATABASE_TRANSACTION_TIMEOUT_MS=15000

# Thoi gian toi da cho mot transaction lay duoc connection; gioi han 15s.
# Production/local: 5000ms. Neu hay cham can kiem tra pool truoc khi tang.
DATABASE_TRANSACTION_MAX_WAIT_MS=5000

# Canh bao request cham. Log chi ghi route da an dinh danh, khong ghi query string.
# Production/local: 500ms la moc khoi dau; dieu chinh sau khi co baseline p95.
SLOW_REQUEST_THRESHOLD_MS=500

# Thu thap query count va tong DB duration theo request qua Prisma event.
# Production: mac dinh false; chi bat trong cua so do ngan co giam sat overhead.
# Local: true khi benchmark, sau khi do co the tat de giam log/telemetry overhead.
DATABASE_QUERY_METRICS_ENABLED=false

# Tra Server-Timing va X-Database-Query-Count de script benchmark doc metric.
# Production: false de khong cong khai thong tin noi bo.
# Local: true khi chay npm run benchmark:api.
PERFORMANCE_HEADERS_ENABLED=false

# Bien chi danh cho script benchmark:api, khong phai cau hinh runtime server.
# BENCHMARK_BASE_URL=http://127.0.0.1:4000/api/v1
# BENCHMARK_ITERATIONS=20
# BENCHMARK_WARMUP_ITERATIONS=3
# BENCHMARK_BEARER_TOKEN=
# BENCHMARK_APPOINTMENT_ID=
# BENCHMARK_INCLUDE_CHATBOT_MESSAGE=false

FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://localhost:3001
# URL cong khai cua backend, dung de tao lien ket callback/payment.
# Production: URL HTTPS cua API; local: http://localhost:4000.
APP_BASE_URL=http://localhost:4000
DASHBOARD_AUTH_CACHE_TTL_MS=30

CHATBOT_SETTINGS_CACHE_TTL_MS=60000
# Cache ngan han catalog khoa/goi/bac si; slot trong van luon doc truc tiep.
# Production/local: 30000ms giup giam round-trip DB nhung van cap nhat nhanh.
CHATBOT_CONTEXT_CACHE_TTL_MS=30000
# Gioi han thoi gian cho Gemini de chatbot kip chuyen sang luong fallback.
# Production: 8000ms can bang giua do chinh xac va do tre; toi da 12000ms.
# Local: giu 8000ms, co the giam de kiem thu fallback khi AI cham/mat mang.
CHATBOT_AI_TIMEOUT_MS=8000

ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_REQUEST_TIMEOUT_MS=700
PUBLIC_SEARCH_ES_QUERY_TIMEOUT_MS=450
PUBLIC_SEARCH_ES_COOLDOWN_MS=30000
PUBLIC_SEARCH_CACHE_TTL_MS=30000

ELASTICSEARCH_NODE=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=

# Redis TCP rieng cho BullMQ. Uu tien bien nay neu duoc khai bao.
# Production: dung instance dedicated voi maxmemory-policy=noeviction de tranh mat job.
# Local: co the de trong va fallback sang REDIS_URL ben duoi.
QUEUE_REDIS_URL=

# Redis TCP fallback cho queue (redis:// hoac rediss://, khong dung REST URL).
REDIS_URL=
OTP_WORKER_CONCURRENCY=5

# Thoi gian toi da cho thao tac dua OTP vao queue truoc khi fallback, don vi ms.
# Production/local: 1000ms; chi tang sau khi da kiem tra Redis/worker.
OTP_ENQUEUE_TIMEOUT_MS=1000

# Production/local mac dinh false de khong spam log khi worker khong co du lieu.
# Chi bat true khi can debug reconciliation/no-op job.
WORKER_LOG_NOOP=false

# Gui nhac lich truoc gio kham bao nhieu phut. Mac dinh 120 phut.
# Production/local: notification worker phai dang chay de phat dung han.
APPOINTMENT_REMINDER_LEAD_MINUTES=120

OTP_DEBUG_ENABLED=false

JWT_SECRET=

DASHBOARD_ACCESS_COOKIE_MAX_AGE_SECONDS=900
DASHBOARD_REFRESH_TOKEN_DAYS="7d"

DASHBOARD_ACCESS_TOKEN_EXPIRES_IN="15m"

OTP_SECRET=

CLOUDINARY_URL=

RESEND_API_KEY=
RESEND_FROM=Hospital Booking <onboarding@resend.dev>
# Ten thuong hieu hien thi trong noi dung email.
MAIL_BRAND_NAME=Hospital Booking

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=web-hospital-booking-51fd2.firebaseapp.com
FIREBASE_PROJECT_ID=web-hospital-booking-51fd2
FIREBASE_STORAGE_BUCKET=web-hospital-booking-51fd2.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
GEMINI_MODEL=gemini-2.5-flash
# PATIENT_JWT_SECRET= # Legacy/unused; Phase 1 patient token dung JWT_SECRET.

# Firebase Admin dung de backend gui push FCM. Chi can khai bao MOT trong hai cach:
# Local: duong dan tuyet doi toi file service-account JSON nam ngoai Git.
# Production: de trong neu dung FIREBASE_SERVICE_ACCOUNT_BASE64 ben duoi.
# GOOGLE_APPLICATION_CREDENTIALS=C:\\secrets\\firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# Production/Render: service-account JSON da encode base64, luu bang Secret.
# Local: co the de trong khi dung GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Chu ky worker retry push that bai. Production nen chay worker:notifications.
# Local: 30000 (30 giay) phu hop de kiem thu.
NOTIFICATION_WORKER_INTERVAL_MS=30000

# So notification toi da worker xu ly moi chu ky.
# Production: 100 la mac dinh can bang, tang dan sau khi theo doi FCM/DB.
# Local: giu 100; gia tri duoc gioi han toi da 500 de tranh burst.
NOTIFICATION_DISPATCH_BATCH_SIZE=100

# So lan gui FCM toi da truoc khi delivery chuyen sang EXHAUSTED.
# Production: 8 la muc an toan, tranh retry vo han khi FCM gap loi dai han.
# Local: co the dat 3 de kiem thu nhanh luong retry that bai.
NOTIFICATION_MAX_DELIVERY_ATTEMPTS=8

# So ngay giu thong bao da doc / chien dich da huy. Thong bao het han duoc don som.
# Production: 180 ngay la moc khoi dau; tang neu chinh sach luu tru yeu cau.
# Local: giu 180, chi giam trong TEST_DATABASE_URL de kiem thu cleanup.
NOTIFICATION_RETENTION_DAYS=180

# Chu ky don thong bao het han/da doc, don vi ms; toi thieu 1 gio.
# Production/local: 21600000 = 6 gio, tranh quet database tren moi vong worker.
NOTIFICATION_CLEANUP_INTERVAL_MS=21600000

# ============================================================================
# PHASE 0 - SECURITY, BOOKING EXPIRY VA PAYMENT SAFETY
# ============================================================================

# Token ngan han duoc cap sau khi benh nhan xac thuc OTP de doc lich hen,
# ket qua, hoa don va thao tac thanh toan dung patient ownership.
# Production: BAT BUOC, toi thieu 32 ky tu, khac JWT_SECRET va OTP_SECRET.
# Local: nen khai bao rieng de test dung behavior production.
LOOKUP_GRANT_SECRET=

# Thoi gian song cua lookup grant.
# Production: nen giu 10-15 phut de giam rui ro token bi lo.
# Local: 15m de test binh thuong; co the tam giam de test token het han.
LOOKUP_GRANT_EXPIRES_IN=15m

# Thoi gian giu slot khi appointment dang PENDING_OTP.
# Production: 10 phut theo Phase 0; resend OTP khong keo dai moc nay.
# Local: dung 1 de test expiry nhanh, sau khi test doi lai 10.
BOOKING_HOLD_MINUTES=10

# So job expiry/reconciliation appointment xu ly dong thoi.
# Production: bat dau voi 5, chi tang sau khi theo doi Redis va database.
# Local: 1-5 deu du; gia tri mac dinh khuyen nghi la 5.
APPOINTMENT_LIFECYCLE_WORKER_CONCURRENCY=5

# Chu ky reconciliation bat cac appointment bi lo job delayed, don vi ms.
# Production: 60000 = moi 1 phut.
# Local: co the dung 10000-30000 de test nhanh.
APPOINTMENT_RECONCILIATION_INTERVAL_MS=60000

# So appointment toi da duoc reconciliation xu ly trong mot lan chay.
# Production: 100 la diem bat dau an toan, dieu chinh theo metric.
# Local: giu 100.
APPOINTMENT_RECONCILIATION_BATCH_SIZE=100

# Cho phep provider MOCK va cac endpoint gia lap thanh toan.
# Production: BAT BUOC false; code cung tu choi MOCK trong production-like.
# Local/test: true neu can test luong payment, false neu khong test payment.
PAYMENT_MOCK_ENABLED=false

# Bat/tat cong thanh toan MoMo. Chi bat sau khi IPN HTTPS cong khai da san sang.
# Production: true khi da duoc MoMo cap credential production va nghiem thu IPN.
# Local: true chi khi test sandbox; neu false thi cac bien MOMO_* khong bat buoc.
PAYMENT_MOMO_ENABLED=false

# Credential do MoMo cap rieng cho sandbox/production. Chi dat o backend/secret manager.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# Sandbox mac dinh co the bo trong; production nen gan endpoint MoMo duoc cap.
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# URL HTTPS MoMo dua nguoi dung quay lai sau thanh toan; khong dung redirect de
# ket luan da tra tien. Nen tro den trang trung lap cua frontend:
# https://web.example.com/payment/return
MOMO_REDIRECT_URL=

# Endpoint HTTPS cong khai de MoMo gui ket qua server-to-server.
# Vi du: https://api.example.com/api/payments/momo/webhook
MOMO_IPN_URL=

MOMO_REQUEST_TYPE=captureWallet
MOMO_LANG=vi
MOMO_PARTNER_NAME=Hospital Booking
MOMO_STORE_ID=HospitalBooking

# CAC BIEN PHASE 0 DA CO O PHAN TREN, KHONG KHAI BAO LAI:
# - TEST_DATABASE_URL: chi dung cho integration test; khong dua len production.
# - OTP_DEBUG_ENABLED: production=false; local/test=true neu can xem OTP debug.
# - REDIS_URL: can cho otp worker va appointment lifecycle worker;
#   phai la redis:// hoac rediss://, khong phai Upstash REST https://.
# - JWT_SECRET va OTP_SECRET: production bat buoc moi secret >= 32 ky tu.

# ============================================================================
# PHASE 1 - PATIENT/MOBILE AUTH, SECURE FILE VA SLOT RECONCILIATION
# ============================================================================

# Thoi gian song access token Bearer cua patient/mobile.
# Production: 10-15 phut; access token ngan han va refresh token duoc rotation.
# Local: 15m de test thong thuong.
PATIENT_ACCESS_TOKEN_EXPIRES_IN=15m

# Thoi gian song cua patient refresh session.
# Production: 30d phu hop ung dung mobile; tung session co the revoke rieng.
# Local: co the dung 1d neu muon test expiry nhanh.
PATIENT_REFRESH_TOKEN_DAYS=30d

# Danh sach hostname backend duoc phep proxy file y te, ngan SSRF.
# Production: chi khai bao domain storage/CDN do he thong quan ly.
# Local: res.cloudinary.com neu dung Cloudinary nhu flow upload hien tai.
MEDICAL_FILE_ALLOWED_HOSTS=res.cloudinary.com

# Gioi han kich thuoc file y te backend proxy, don vi byte.
# Production/local: 20971520 = 20 MiB; can dong bo voi upload policy.
MEDICAL_FILE_MAX_BYTES=20971520

# Chu ky worker kiem tra lien ket Appointment <-> DoctorTimeSlot, don vi ms.
# Production: 300000 = moi 5 phut; chi auto-fix cac sai lech co ket qua xac dinh.
# Local: co the giam de test worker.
SLOT_RECONCILIATION_INTERVAL_MS=300000

# So slot toi da duoc doi soat trong mot job.
# Production: bat dau voi 200 va dieu chinh theo metric database.
# Local: giu 200.
SLOT_RECONCILIATION_BATCH_SIZE=200

# KHONG CAN PATIENT_JWT_SECRET RIENG: patient access token dung JWT_SECRET chung
# nhung bat buoc audience/issuer/tokenType va sessionId, nen khong chap nhan lan
# voi dashboard token. Neu PATIENT_JWT_SECRET dang co thi code hien tai khong doc.
