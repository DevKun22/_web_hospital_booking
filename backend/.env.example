PORT=4000
# NODE_ENV=production
# DASHBOARD_COOKIE_SAME_SITE=none
NODE_ENV=development
DASHBOARD_COOKIE_SAME_SITE=lax
NPM_CONFIG_PRODUCTION=false

DATABASE_URL=
TEST_DATABASE_URL=
TEST_DATABASE_DESTRUCTIVE_OK=I_UNDERSTAND_TEST_DATA_WILL_BE_DELETED

FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://localhost:3001
APP_BASE_URL=http://localhost:4000
DASHBOARD_AUTH_CACHE_TTL_MS=30

CHATBOT_SETTINGS_CACHE_TTL_MS=60000
# Gioi han thoi gian cho Gemini de chatbot kip chuyen sang luong fallback.
# Production: 8000ms can bang giua do chinh xac va do tre; toi da 12000ms.
# Local: giu 8000ms, co the giam de kiem thu fallback khi AI cham/mat mang.
CHATBOT_AI_TIMEOUT_MS=8000

ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_REQUEST_TIMEOUT_MS=700
PUBLIC_SEARCH_ES_QUERY_TIMEOUT_MS=450
PUBLIC_SEARCH_ES_COOLDOWN_MS=30000
PUBLIC_SEARCH_CACHE_TTL_MS=30000

ELASTICSEARCH_NODE=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=

REDIS_URL=
OTP_WORKER_CONCURRENCY=5

OTP_DEBUG_ENABLED=false

JWT_SECRET=

DASHBOARD_ACCESS_COOKIE_MAX_AGE_SECONDS=900
DASHBOARD_REFRESH_TOKEN_DAYS="7d"

DASHBOARD_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_EXPIRES_IN="15m"

OTP_SECRET=

CLOUDINARY_URL=

RESEND_API_KEY=
RESEND_FROM=Hospital Booking <onboarding@resend.dev>

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=web-hospital-booking-51fd2.firebaseapp.com
FIREBASE_PROJECT_ID=web-hospital-booking-51fd2
FIREBASE_STORAGE_BUCKET=web-hospital-booking-51fd2.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
GEMINI_MODEL=gemini-2.5-flash

CAPTCHA_SITEKEY=
CAPTCHA_SECRETKEY=
# PATIENT_JWT_SECRET= # Legacy/unused; Phase 1 patient token dung JWT_SECRET.
API_BASE_URL=
MOBILE_TEST_DATABASE_URL=
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================================================
# PHASE 0 - SECURITY, BOOKING EXPIRY VA PAYMENT SAFETY
# ============================================================================

# Token ngan han duoc cap sau khi benh nhan xac thuc OTP de doc lich hen,
# ket qua, hoa don va thao tac thanh toan dung patient ownership.
# Production: BAT BUOC, toi thieu 32 ky tu, khac JWT_SECRET va OTP_SECRET.
# Local: nen khai bao rieng de test dung behavior production.
LOOKUP_GRANT_SECRET=

# Thoi gian song cua lookup grant.
# Production: nen giu 10-15 phut de giam rui ro token bi lo.
# Local: 15m de test binh thuong; co the tam giam de test token het han.
LOOKUP_GRANT_EXPIRES_IN=15m

# Thoi gian giu slot khi appointment dang PENDING_OTP.
# Production: 10 phut theo Phase 0; resend OTP khong keo dai moc nay.
# Local: dung 1 de test expiry nhanh, sau khi test doi lai 10.
BOOKING_HOLD_MINUTES=10

# So job expiry/reconciliation appointment xu ly dong thoi.
# Production: bat dau voi 5, chi tang sau khi theo doi Redis va database.
# Local: 1-5 deu du; gia tri mac dinh khuyen nghi la 5.
APPOINTMENT_LIFECYCLE_WORKER_CONCURRENCY=5

# Chu ky reconciliation bat cac appointment bi lo job delayed, don vi ms.
# Production: 60000 = moi 1 phut.
# Local: co the dung 10000-30000 de test nhanh.
APPOINTMENT_RECONCILIATION_INTERVAL_MS=60000

# So appointment toi da duoc reconciliation xu ly trong mot lan chay.
# Production: 100 la diem bat dau an toan, dieu chinh theo metric.
# Local: giu 100.
APPOINTMENT_RECONCILIATION_BATCH_SIZE=100

# Cho phep provider MOCK va cac endpoint gia lap thanh toan.
# Production: BAT BUOC false; code cung tu choi MOCK trong production-like.
# Local/test: true neu can test luong payment, false neu khong test payment.
PAYMENT_MOCK_ENABLED=false

# CAC BIEN PHASE 0 DA CO O PHAN TREN, KHONG KHAI BAO LAI:
# - TEST_DATABASE_URL: chi dung cho integration test; khong dua len production.
# - TEST_DATABASE_DESTRUCTIVE_OK: chi dung voi test project rieng co URL /postgres.
# - OTP_DEBUG_ENABLED: production=false; local/test=true neu can xem OTP debug.
# - REDIS_URL: can cho otp worker va appointment lifecycle worker;
#   phai la redis:// hoac rediss://, khong phai Upstash REST https://.
# - JWT_SECRET va OTP_SECRET: production bat buoc moi secret >= 32 ky tu.

# ============================================================================
# PHASE 1 - PATIENT/MOBILE AUTH, SECURE FILE VA SLOT RECONCILIATION
# ============================================================================

# Thoi gian song access token Bearer cua patient/mobile.
# Production: 10-15 phut; access token ngan han va refresh token duoc rotation.
# Local: 15m de test thong thuong.
PATIENT_ACCESS_TOKEN_EXPIRES_IN=15m

# Thoi gian song cua patient refresh session.
# Production: 30d phu hop ung dung mobile; tung session co the revoke rieng.
# Local: co the dung 1d neu muon test expiry nhanh.
PATIENT_REFRESH_TOKEN_DAYS=30d

# Danh sach hostname backend duoc phep proxy file y te, ngan SSRF.
# Production: chi khai bao domain storage/CDN do he thong quan ly.
# Local: res.cloudinary.com neu dung Cloudinary nhu flow upload hien tai.
MEDICAL_FILE_ALLOWED_HOSTS=res.cloudinary.com

# Gioi han kich thuoc file y te backend proxy, don vi byte.
# Production/local: 20971520 = 20 MiB; can dong bo voi upload policy.
MEDICAL_FILE_MAX_BYTES=20971520

# Chu ky worker kiem tra lien ket Appointment <-> DoctorTimeSlot, don vi ms.
# Production: 300000 = moi 5 phut; chi auto-fix cac sai lech co ket qua xac dinh.
# Local: co the giam de test worker.
SLOT_RECONCILIATION_INTERVAL_MS=300000

# So slot toi da duoc doi soat trong mot job.
# Production: bat dau voi 200 va dieu chinh theo metric database.
# Local: giu 200.
SLOT_RECONCILIATION_BATCH_SIZE=200

# KHONG CAN PATIENT_JWT_SECRET RIENG: patient access token dung JWT_SECRET chung
# nhung bat buoc audience/issuer/tokenType va sessionId, nen khong chap nhan lan
# voi dashboard token. Neu PATIENT_JWT_SECRET dang co thi code hien tai khong doc.
