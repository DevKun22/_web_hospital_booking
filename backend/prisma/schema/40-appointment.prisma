// Lịch hẹn, nhật ký lịch hẹn và đánh giá sau khám.

enum AppointmentStatus {
  PENDING_OTP // Đã tạo lịch nhưng chưa xác thực OTP
  PENDING_CONFIRM // Đã xác thực OTP, chờ nhân viên/bác sĩ xác nhận
  CONFIRMED // Đã xác nhận lịch khám
  CHECKED_IN // Bệnh nhân đã đến/check-in
  IN_PROGRESS // Đang khám
  COMPLETED // Đã khám xong
  RESCHEDULED // Đã được dời lịch
  CANCELLED_BY_PATIENT // Bệnh nhân hủy
  CANCELLED_BY_DOCTOR // Bác sĩ hủy
  CANCELLED_BY_ADMIN // Admin/Staff hủy
  NO_SHOW // Bệnh nhân không đến
}

enum AppointmentLogAction {
  APPOINTMENT_CREATED
  OTP_SENT
  OTP_VERIFIED
  CONFIRMED
  RESCHEDULED
  CANCELLED_BY_PATIENT
  CANCELLED_BY_DOCTOR
  CANCELLED_BY_ADMIN
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  MEDICAL_RESULT_CREATED
  INVOICE_CREATED
  PAYMENT_RECORDED
  INVOICE_CANCELLED
  PAYMENT_REFUNDED
  // Nhật ký thao tác lâm sàng (chỉ ghi ai làm gì, không ghi nội dung y tế)
  MEDICAL_RESULT_UPDATED
  MEDICAL_RESULT_PUBLISHED
  LAB_RESULT_CHANGED
  PRESCRIPTION_ISSUED
  PRESCRIPTION_CANCELLED
  PRESCRIPTION_DISPENSED
}

model Appointment {
  id          String @id @default(uuid())
  bookingCode String @unique

  appointmentDate DateTime
  startTime       String
  endTime         String
  status          AppointmentStatus @default(PENDING_OTP)
  holdExpiresAt   DateTime?

  reason String?

  // Thông tin đặt lịch snapshot để không mất dữ liệu nếu user đổi profile
  patientName  String
  patientPhone String
  patientEmail String?
  otpChannel   OtpChannel @default(SMS)
  patientGender Gender?
  patientDateOfBirth DateTime?
  patientAddress String?
  patientCccd String?

  hasBHYT             Boolean @default(false)
  healthInsuranceCode String?
  registeredHospital  String?
  allergies           String?
  medicalHistory      String?
  familyHistory       String?

  // Thời điểm và phiên bản thông báo người đặt lịch đã đồng ý khi nhập dữ liệu
  // sức khỏe (dị ứng, tiền sử). Null khi không nhập dữ liệu sức khỏe.
  healthConsentAt      DateTime?
  healthConsentVersion String?

  estimatedPrice Int @default(0)
  serviceFee     Int @default(0)
  bhytDiscount   Int @default(0)
  finalAmount    Int @default(0)

  patientId String
  patient   User   @relation("PatientAppointments", fields: [patientId], references: [id])

  // Null = đặt cho bản thân. Có giá trị = snapshot phía trên thuộc hồ sơ người
  // thân này; patientId vẫn là tài khoản quản lý và nhận OTP/thông báo.
  dependentProfileId String?
  dependentProfile   DependentProfile? @relation(fields: [dependentProfileId], references: [id], onDelete: SetNull)

  doctorId String
  doctor   DoctorProfile @relation("DoctorAppointments", fields: [doctorId], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  timeSlotId String?         @unique
  timeSlot   DoctorTimeSlot? @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)

  // Nếu lịch này được dời từ lịch cũ, lưu lại lịch gốc để truy vết
  rescheduledFromId String?
  rescheduledFrom   Appointment?  @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo     Appointment[] @relation("AppointmentReschedule")
  rescheduledReason String?
  rescheduledAt     DateTime?

  cancelledByRole Role?
  cancelledById   String?
  cancelledReason String?

  medicalRecord MedicalRecord?
  prescription  Prescription?
  invoice       Invoice?
  review        Review?
  logs          AppointmentLog[]

  confirmedAt DateTime?
  cancelledAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, appointmentDate])
  @@index([departmentId])
  @@index([appointmentDate])
  @@index([patientPhone])
  @@index([status, holdExpiresAt])
  @@index([status, appointmentDate])
  @@index([status, createdAt])
  @@index([patientId, status, appointmentDate])
  @@index([dependentProfileId, appointmentDate])
  @@index([rescheduledFromId])
  @@index([packageId])
}

// Lưu lịch sử thay đổi lịch hẹn: tạo lịch, xác thực OTP, dời lịch, hủy lịch, hoàn thành...
model AppointmentLog {
  id String @id @default(uuid())

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  action AppointmentLogAction
  note   String?

  oldDate      DateTime?
  oldStartTime String?
  oldEndTime   String?

  newDate      DateTime?
  newStartTime String?
  newEndTime   String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([appointmentId])
  @@index([action])
  @@index([createdById])
}

model Review {
  id      String  @id @default(uuid())

  // Diem tong hop do he thong tinh tu ba tieu chi, de phuc vu thong ke nhanh.
  rating          Float
  doctorRating    Int
  serviceRating   Int
  facilityRating  Int
  comment         String?

  // Nhan vien co the an danh gia khoi bao cao noi bo khi can kiem duyet.
  isVisible       Boolean   @default(false)
  moderationNote  String?
  moderatedAt     DateTime?

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId])
  @@index([isVisible])
  @@index([createdAt])
}
