// Danh mục công khai: chuyên khoa, bác sĩ, gói khám.

model Department {
  id                String   @id @default(uuid())
  name              String   @unique
  slug              String   @unique
  description       String?
  image             String?
  // Nội dung giới thiệu theo mục có tiêu đề, dựng thành các tab ở trang chuyên khoa: [{ title, body (Markdown) }].
  sections          Json     @default("[]")
  // Người duyệt nội dung chuyên môn (tên hiển thị công khai) và thời điểm cập nhật nội dung.
  contentReviewerName String?
  contentUpdatedAt    DateTime?
  symptomKeywords   String[] @default([])
  triageDescription String?
  isTriageFallback  Boolean  @default(false)
  isActive          Boolean  @default(true)

  doctors      DoctorProfile[]
  appointments Appointment[]
  packages     Package[]
  articles     Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isTriageFallback, isActive])
}

model DoctorProfile {
  id     String @id @default(uuid())
  slug   String @unique
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  title                  String?
  bio                    String?
  // Phần giới thiệu công khai do bác sĩ soạn: chỉ hiện sau khi quản trị duyệt (xem profileDraft).
  motto                  String?
  careerTimeline         Json                    @default("[]") // [{ period, place, role? }]
  memberships            Json                    @default("[]") // [tên hiệp hội]
  expertise              Json                    @default("[]") // [lĩnh vực chuyên sâu]
  profileReviewerName    String?
  profileUpdatedAt       DateTime?
  // Bản bác sĩ gửi chờ duyệt (null = không có). Quản trị duyệt thì được áp vào các cột trên rồi xóa.
  profileDraft           Json?
  profileDraftAt         DateTime?
  specialization         String?
  scheduleChangeRequests ScheduleChangeRequest[]
  experience             Int?
  consultationFee        Int                     @default(0)

  isAvailable Boolean @default(true)

  appointments   Appointment[]    @relation("DoctorAppointments")
  schedules      DoctorSchedule[]
  timeSlots      DoctorTimeSlot[]
  medicalRecords MedicalRecord[]  @relation("DoctorRecords")
  prescriptions  Prescription[]   @relation("DoctorPrescriptions")
  reviews        Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
}

// Gói khám tổng quan
// Ví dụ: Khám tổng quát, Khám chuyên khoa, Gói sàng lọc ban đầu
model Package {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  // Đối tượng nên làm, thời gian có kết quả, hỏi đáp riêng của gói.
  audience    Json    @default("[]") // [string]
  resultTime  String?
  faq         Json    @default("[]") // [{ question, answer }]

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Giá hiển thị chính của gói
  basePrice  Int
  serviceFee Int @default(0)

  // Mô tả nhanh trên giao diện
  summary       String?
  note          String?
  image         String?
  isPopular     Boolean @default(false)
  isBHYTSupport Boolean @default(false)
  isActive      Boolean @default(true)

  // Chi tiết từng hạng mục trong gói khám
  items PackageItem[]

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
}

// Chi tiết gói khám
// Dùng để nói rõ gói này khám những gì và từng mục có phí bao nhiêu
model PackageItem {
  id String @id @default(uuid())

  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  name        String // VD: Khám lâm sàng, Xét nghiệm máu, Siêu âm bụng
  description String?

  // Giá của từng hạng mục. Nếu đã nằm trong gói thì có thể để 0 hoặc included = true
  price    Int     @default(0)
  included Boolean @default(true)

  // Thứ tự hiển thị trên giao diện
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId])
}

// Cơ sở khám (chi nhánh). Hiện chỉ dùng để gắn lịch làm việc, khung giờ và lịch hẹn với một địa điểm; dữ liệu cũ chưa gán (null)
// được hiểu là cơ sở mặc định. Kho thuốc, phân quyền và báo cáo theo cơ sở thuộc hướng phát triển.
model Facility {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  address      String
  phone        String?
  workingHours String?
  mapUrl       String?
  // Đúng một cơ sở mặc định: nhận ca làm việc mới khi không chọn cơ sở.
  isDefault    Boolean @default(false)
  isActive     Boolean @default(true)

  schedules    DoctorSchedule[]
  timeSlots    DoctorTimeSlot[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
