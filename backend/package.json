{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "prisma generate && tsc",
    "worker:otp:dev": "tsx src/workers/otp.worker.ts",
    "worker:appointments:dev": "tsx src/workers/appointmentLifecycle.worker.ts",
    "worker:payments:dev": "tsx src/workers/paymentReconciliation.worker.ts",
    "worker:notifications:dev": "tsx src/workers/notification.worker.ts",
    "test": "tsx --test test/smoke/app.test.ts",
    "test:integration": "tsx test/runIntegrationTests.ts",
    "test:e2e": "tsx test/runIntegrationTests.ts patient journey",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:all": "prisma generate && tsc --noEmit -p tsconfig.test.json && tsx --test test/smoke/app.test.ts && npm run test:unit && tsx test/runIntegrationTests.ts",
    "seed:demo-full": "tsx src/scripts/seedDemoData.ts",
    "seed:chatbot-faq": "tsx src/scripts/seedChatbotFAQ.ts",
    "check:queue-redis": "tsx src/scripts/checkQueueRedis.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset",
    "render:build": "npm run prisma:migrate:deploy && npm run build",
    "test:unit": "tsx --test test/unit/patientSessionPolicy.test.ts test/unit/requestParsers.test.ts test/unit/vnpayProvider.test.ts test/unit/bookingIdentity.test.ts test/unit/rateLimit.test.ts test/unit/permissions.test.ts test/unit/inlineWorkers.test.ts test/unit/routePermissions.test.ts test/unit/medicalFile.test.ts test/unit/concurrency.test.ts test/unit/runtimeMetrics.test.ts test/unit/runtimeConfig.test.ts test/unit/csvExport.test.ts test/unit/csvParse.test.ts test/unit/maskContact.test.ts test/unit/stockBatch.test.ts test/unit/readiness.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.78.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "resend": "^6.12.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.8.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
