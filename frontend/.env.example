# URL công khai dùng để tạo canonical, Open Graph, robots.txt và sitemap.xml.
# Production: thay bằng tên miền HTTPS chính thức, không dùng localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API công khai mà frontend gọi khi render nội dung và tạo sitemap động.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Mã xác minh Google Search Console (không phải khóa bí mật).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
