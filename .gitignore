# dependencies
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# env
.env
.env.*
*.env
!.env.example
!.env.local.example
production.example.env

# build outputs
.next/
out/
dist/
build/
coverage/

# generated
backend/generated/
backend/generated/prisma/
frontend/.next/
frontend/out/

# cache
.turbo/
.cache/
.codex/
.eslintcache
*.tsbuildinfo
.frontend-dev.pid

# Graphify keeps the project graph at the repository root. Local AST caches
# and per-package graphs are rebuildable intermediates and should stay local.
**/graphify-out/

# Archify exports the reusable source and HTML explainer. Delivery/finalization
# metadata is local execution state and can be regenerated.
.archify/**/*.delivery.json
.archify/**/*.finalize.json
.archify/**/*.finalize-summary.json

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
yarn-error.log*

# OS/editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/

# Vercel / local deploy
.vercel/

# uploads/temp
tmp/
.archify/
.codex/*
!.codex/skills/
!.codex/hooks.json
temp/
uploads/
*.tmp

# secrets/certs
*.pem
*.key
*.crt
backend/secrets/

# other
# Tài liệu, báo cáo và nhật ký chỉ giữ trên máy, không đưa lên Git
docs/

# Archify working candidates and browser-check evidence (final HTML stays in docs/)
.archify/
tools

# Anh chup kiem thu thiet bi (khong commit)
mobile/.qa-device/

# Docker: tạm thời không đưa lên Git, sẽ dựng lại khi cần đóng gói triển khai (production chạy trên Render theo kiểu Node, không dùng Docker)
backend/Dockerfile
backend/.dockerignore
compose*.yaml
docker/
